# Serveur de la carte (server/env.ts). En local : copier en .env.local et remplir.
# En production, ces variables sont posées dans Dokploy (MIGRATION.md), jamais dans le dépôt.

# Adresse publique de la carte : http://localhost:5173 en local (Vite passe /api au serveur)
GD_MAP_BASE_URL=http://localhost:5173
GD_MAP_DATABASE_URL=postgres://postgres:dev@localhost:5432/gd_map
# Au moins 32 caractères : openssl rand -base64 32
GD_MAP_AUTH_SECRET=

# Connexion par le portail GDCOM (noms affichés par le guide de branchement du support)
GD_MAP_OIDC_ISSUER=http://localhost:3400
GD_MAP_OIDC_CLIENT_ID=
# Vide pour un client « native » de développement ; obligatoire en production
GD_MAP_OIDC_CLIENT_SECRET=

# Premiers admins, séparés par des virgules (ajoutés au démarrage s'ils n'ont pas encore de rôle)
GD_MAP_ADMINS=

# Sans portail en local : une personne simulée, admise d'office (refusé en production)
# GD_MAP_DEV_SESSION=moi@exemple.fr
