{
  "name": "gd-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env.local server/index.ts",
    "demo": "VITE_DEMO=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src scripts server db",
    "build:geo": "node scripts/build-geo.mjs",
    "gen:zones-sql": "node scripts/gen-zones-sql.ts",
    "sample:excel": "node scripts/make-sample-excel.mjs",
    "auth:schema": "npx --yes auth@1.7.5 generate --config server/auth-schema.ts --output better-auth.generated.sql --yes"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "better-auth": "1.7.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "hono": "4.13.8",
    "pg": "8.23.0",
    "polylabel": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "mapshaper": "^0.7.72",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
